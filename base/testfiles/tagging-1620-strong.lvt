% \usepackage{color}
% instead of loading color we do
\DeclareRobustCommand\color[1]{\def\currentcolor{#1}}
\color{black}

\makeatletter
\def\showfont{\typeout{\f@encoding/\f@family/\f@series/\f@shape \space (color: \currentcolor)}}
\makeatother

\begin{document}

