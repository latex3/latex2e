\strongemph{\showfont first
\strongemph{\showfont second
\strongemph{\showfont third
\strongemph{\showfont fourth
\strongemph{\showfont fifth}}}}}}


\typeout{========== std LaTeX already bold italic ==========}
\textbf{\itshape \showfont Start
\strongemph{\showfont first
\strongemph{\showfont second
\strongemph{\showfont third
\strongemph{\showfont fourth
\strongemph{\showfont fifth}}}}}}


