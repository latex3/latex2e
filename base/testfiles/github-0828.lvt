\makeatletter
\def\showinnerdate{\typeout{--> \pkgcls@innerdate }}
\makeatother

\begin{filecontents}[force]{demo.sty}
\DeclareCurrentRelease{}{2021-02-02}
\showinnerdate

\AddToHook{package/alltt/before}{\showinnerdate}
\AddToHook{package/alltt/after}{\showinnerdate}

\RequirePackage{alltt}[=2000-01-01]   % actually a fake there is no version info

\showinnerdate
\end{filecontents}

\input{test2e}

\documentclass{article}

\START

\showinnerdate

\IfTargetDateBefore{2023-01-01}{\typeout{old}}{\typeout{new}} % => new 

\usepackage{demo}[=2022-02-02]

\showinnerdate

\IfTargetDateBefore{2023-01-01}{\typeout{old}}{\typeout{new}} % => new 

\showinnerdate

\END


