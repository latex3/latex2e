%

\documentclass{minimal}
\input{regression-test}
\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Joseph Wright}
\ExplSyntaxOn
\DebugTemplatesOn

\OMIT
\NewTemplateType { test-zero } 0
\DeclareTemplateInterface { test-zero } { template } 0 {
  key-one   : tokenlist = default ,
  key-two   : tokenlist           ,
  key-three : integer   = 4
}
\DeclareTemplateCode { test-zero } { template } 0 {
  key-one   = \KeyOne   ,
  key-two   = \KeyTwo   ,
  key-three = \KeyThree
}
{
  \tl_show:N  \KeyOne
  \tl_show:N  \KeyTwo
  \int_show:N \KeyThree
}
\TIMO

\TEST { Valid~equivalent~creation }
  {
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      {
        key-four  : alias = key-one ,
        key-five  : meta  = { key-one = {#1} , key-two = { X #1 Y } } , 
        key-six   : alias = key-three ,
        key-seven : alias = key-one
      }
    \UseTemplate { test-zero } { template } { key-four = A }
    \UseTemplate { test-zero } { template } { key-five = B }
    \UseTemplate { test-zero } { template } { key-five = C , key-four = D }
    \UseTemplate { test-zero } { template } { key-six = 3 }
    \UseTemplate { test-zero } { template } { key-five = C , key-seven = D }
    \UseTemplate { test-zero } { template } { key-one = E }
    \UseTemplate { test-zero } { template } { key-one = F , key-four = G }
    \UseTemplate { test-zero } { template } { key-four = H , key-one = I }
  }

\TEST { Invalid~equivalent~creation }
  {
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      {
        key-one   : alias = key-two  ,
        key-eight : alias = key-nine ,
        key-ten   : meta = { key-eleven = {#1} , key-twelve = {#1} }
      }
  }

\TEST { Equivalent~recreation }
  {
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      {
        key-four   : alias = key-two
      }
    \UseTemplate { test-zero } { template }
      { key-one = A , key-two = B , key-four = C }
  }

\TEST { Ad~hoc~keys }
  {
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      {
        key-four  : alias = key-one ,
        key-five  : meta  = { key-one = {#1} , key-two = { X #1 Y } } , 
      }
    \keys_set:nn { template / test-zero / template }
      {
        key-four = J
      }
    \tl_show:N \KeyOne
    \keys_set:nn { template / test-zero / template }
      {
        key-five = J
      }
    \tl_show:N \KeyOne
    \tl_show:N \KeyTwo
  }

\TEST { Deprecation~date }
  {
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      [ 2000-01-01 ]
      { key-four  : alias = key-one }
    \DeclareTemplateInterfaceEquivalents { test-zero } { template }
      [ 2100-01-01 ]
      { key-four  : alias = key-one }
  }

\END
