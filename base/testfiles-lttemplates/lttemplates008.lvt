%

\documentclass{minimal}
\input{regression-test}
\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Joseph Wright}
\ExplSyntaxOn
\DebugTemplatesOn

\OMIT
\NewTemplateType { test-zero } 0
\DeclareTemplateInterface { test-zero } { template } 0 {
  key-one   : tokenlist = default ,
  key-two   : tokenlist           ,
  key-three : integer   = 4       ,
  key-four  : choice { one, two, three }
}
\DeclareTemplateCode { test-zero } { template } 0 {
  key-one   = \KeyOne   ,
  key-two   = \KeyTwo   ,
  key-three = \KeyThree ,
  key-four  = \KeyFour
}
{
  \show \KeyOne
  \show \KeyTwo
  \showthe \KeyThree
  \show \KeyFour
}
\TIMO

\TEST { Valid~alias~creation }
  {
    \DeclareTemplateInterfaceAlias { test-zero } { template }
      {
        key-five = key-one , key-six = { key-one , key-two } ,
        key-seven = key-three
      }
    \UseTemplate { test-zero } { template }
      { key-five = A , key-seven = 1 }
    \UseTemplate { test-zero } { template }
      { key-five = A , key-six = B }
    \UseTemplate { test-zero } { template }
      { key-six = B , key-five = A }
  }

\TEST { Alias~errors }
  {
    \DeclareTemplateInterfaceAlias { test-XXX } { template }
      { key-five = key-ten }
    \DeclareTemplateInterfaceAlias { test-zero } { template }
      { key-five = key-ten }
  }

\END
