%

\documentclass{minimal}
\input{regression-test}
\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Joseph Wright}
\ExplSyntaxOn
\DebugTemplatesOn

\OMIT
\NewTemplateType { test-zero } 0
\DeclareTemplateInterface { test-zero } { template } 0 {
  key-one   : tokenlist = default ,
  key-two   : integer   = 1       ,
  key-three : real      = 2.45    ,
  key-four  : commalist = {a,b}   ,
  key-five  : function{0}
}
\DeclareTemplateCode { test-zero } { template } 0 {
  key-one   = \KeyOne   ,
  key-two   = \KeyTwo   ,
  key-three = \KeyThree ,
  key-four  = \KeyFour  ,
  key-five  = \KeyFive
}
{
  \tl_show:N    \KeyOne
  \int_show:N   \KeyTwo
  \fp_show:N    \KeyThree
  \clist_show:N \KeyFour
  \cs_show:N     \KeyFive
}
\TIMO

\TEST { Valid~augmentation }
  {
    \UseTemplate { test-zero } { template } { key-one += A }
    \UseTemplate { test-zero } { template } { key-two += 1 }
    \UseTemplate { test-zero } { template } { key-three += 0.12 }
    \UseTemplate { test-zero } { template } { key-four += c }
  }

\TEST { Invalid~augmentation }
  {
    \UseTemplate { test-zero } { template } { key-five += A }
    \UseTemplate { test-zero } { template } { key-six += A }
    \UseTemplate { test-zero } { template } { key+seven = A }
  }

\END
