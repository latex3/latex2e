\Documentmetadata{}

\input{regression-test}

\DebugTemplatesOn

\START

\TESTTITLE { template type  }

\NewTemplateType {test} {0}

\TESTTITLE { template interface }

    \DeclareTemplateInterface {test} {std} {0} {key :tokenlist=default}


\TESTTITLE { template code  }

    \DeclareTemplateCode {test} {std} {0} {key=\foo} 
       {\typeout{In template 'test/std' with key \foo}}


\TESTTITLE { instance }

    \DeclareInstance {test} {inst-1} {std} {}

    \EditInstance {test} {inst-1} {key=changed}

    \ShowInstanceValues{test}{inst-1}


\TESTTITLE { use instance  }

    \UseInstance {test} {inst-1}



\TESTTITLE { template type --indirect }

\newcommand\mytype{test1}
\newcommand\mytemplate{std1}
\newcommand\myinstance{inst1}


\NewTemplateType \mytype  {0}

\TESTTITLE { template interface --indirect }

\DeclareTemplateInterface \mytype  \mytemplate {0} {key :tokenlist=default}

\TESTTITLE { template code  --indirect }

    \DeclareTemplateCode \mytype  \mytemplate {0} {key=\foo} 
       {\typeout{In template 'test/std' with key \foo}}


\TESTTITLE { instance --indirect }

    \DeclareInstance \mytype {\myinstance-1} \mytemplate {}

    \EditInstance \mytype {\myinstance-1} {key=changed}

    \ShowInstanceValues \mytype {\myinstance-1}


\TESTTITLE { use instance  --indirect }

    \UseInstance \mytype  {\myinstance-1}


\END
