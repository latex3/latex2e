\ExplSyntaxOn
\cs_set:Npn \tbl_crcr:n #1 {
    \int_compare:nNnT \g__tbl_col_int > 0
        {
          \tbl_count_missing_cells:n {#1}
        }
%    \end{macrocode}
%    Even if we are at the start of a row we my have to do a \cs{cr},
