\documentclass{article}

\input{test2e}

\usepackage{longtable}

\begin{document}

\START

% gh/2227: LT@tables has to be stepped for every longtable, also for
% one without caption counter (empty \LTcaptype). Otherwise the
% column widths and the link target are shared with the previous table.

\makeatletter
\newcommand\saveLT{\xdef\savedHref{\@currentHref}}
\newcommand\showLT{%
  \typeout{LT@tables=\the\value{LT@tables},
           table=\the\value{table},
           target=\savedHref}}
\makeatother

\begin{longtable}{l}
\caption{numbered}\\
a\saveLT\\
\end{longtable}
\showLT

\renewcommand\LTcaptype{}
\begin{longtable}{l}
b\saveLT\\
\end{longtable}
\showLT

\begin{longtable}{l}
c\saveLT\\
\end{longtable}
\showLT

\renewcommand\LTcaptype{table}
\begin{longtable}{l}
\caption{numbered}\\
d\saveLT\\
\end{longtable}
\showLT

\OMIT
\end{document}
