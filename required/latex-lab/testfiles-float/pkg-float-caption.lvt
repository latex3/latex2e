\documentclass{article}
\usepackage{float}

\floatstyle{ruled}
\newfloat{floatruled}{htbp}{rld} 
\floatstyle{boxed}
\newfloat{floatboxed}{htbp}{bxd}
\floatstyle{plain}
\newfloat{floatplain}{htbp}{pln} 
\floatstyle{plaintop}
\newfloat{floatplaintop}{htbp}{plp} 
 
\title{Float package captions test}  

\usepackage{lipsum}

\begin{document}
\START
\SHOWPDFTAGS

\floatstyle{ruled}
\restylefloat{figure}
\begin{figure}
\caption{abc}[\emph{continued} \begin{itemize}\item bla\end{itemize}]
ruled
\end{figure}

\floatstyle{boxed}
\restylefloat{figure}
\begin{figure}
boxed
\caption{abc}[continued]
\end{figure}

\floatstyle{plain}
\restylefloat{figure}
\begin{figure}
plain
\caption{abc}[continued]
\end{figure}

\floatstyle{plaintop}
\restylefloat{figure}
\begin{figure}
plaintop
\caption{abc}[continued]
\end{figure}

%\end{document}
\begin{floatruled}%[H]
xxx
\caption{abc}[continued]
 \end{floatruled}

%\end{document}
\begin{floatruled}%[H]
xxx
\caption{abc}
\end{floatruled}

\begin{floatruled}%[H]
xxx
\caption{\lipsum[1][1-2]}
\end{floatruled}


\begin{floatruled}%[H]
xxx
\caption{\lipsum[1][1-2]}[continued]
\end{floatruled}

\begin{floatplain}%[H]
\caption{abc}[continued]
xxx 
\end{floatplain}

\begin{floatplain}%[H]
\caption{abc}
xxx
\end{floatplain}

\begin{floatplain}%[H]
\caption{\lipsum[1][1-2]}
xxx
\end{floatplain}


\begin{floatplain}%[H]
\caption{\lipsum[1][1-2]}[continued]
xxx
\end{floatplain}


\begin{floatplaintop}%[H]
xxx 
\caption{abc}[continued]

\end{floatplaintop}

\begin{floatplaintop}%[H]
xxx
\caption{abc}
\end{floatplaintop}

\begin{floatplaintop}%[H]
xxx
\caption{\lipsum[1][1-2]}
\end{floatplaintop}


\begin{floatplaintop}%[H]
xxx
\caption{\lipsum[1][1-2]}[continued]
\end{floatplaintop}

\begin{floatboxed}%[H]
\caption{abc}[continued]
xxx 
\end{floatboxed}

\begin{floatboxed}%[H]
\caption{abc}
xxx
\end{floatboxed}

\begin{floatboxed}%[H]
\caption{\lipsum[1][1-2]}
xxx
\end{floatboxed}


\begin{floatboxed}%[H]
\caption{\lipsum[1][1-2]}[continued]
xxx
\end{floatboxed}
\end{document} 