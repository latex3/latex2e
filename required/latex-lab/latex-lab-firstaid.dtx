% \subsubsection{Headings}
%
% \changes{0.85r}{2026-01-06}
%      {Add tagging support for headings in ams-classes, tagging issue \#970}
% \changes{v0.85u}{2026-04-24}{Adapt keys to changes in sec-template.}  
% \changes{0.85y}{2026-07-11}{Provide proper heading instances for all
%    ams classes (tagging/1477)}
%
%    The classes redefine \cs{@startsection} and define their own
%    heading commands which are not tagging compatible.
%    This code is therefore disabled and replaced by standard
%    definitions that process the heading arguments and call a
%    suitable template instance. The top-level definitions are
%    identical for all classes (only the heading instances then
%    differ).
%
%    \begin{macrocode}
\DeclareDocumentCommand \part {s ={shorttitle}o m}
    { \ParseLaTeXeHeading {part} {#1} {#2} {#3} }
%    \end{macrocode}
%    
%    Chapters only exist in \cls{amsbook} and their top-level
%    definition is also slightly special as we need a different
%    heading instance for numbered and unnumbered chapters.
%    \begin{macrocode}
%<*amsbook>
\DeclareDocumentCommand \chapter {s ={shorttitle}O{} m}
  {
    \IfBooleanTF{#1}
      { \ParseLaTeXeHeading {chapter*} {#1} {#2} {#3} }
      { \ParseLaTeXeHeading {chapter}  {#1} {#2} {#3} }
  }
%</amsbook>
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareDocumentCommand \section {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {section} {#1} {#2} {#3} }
%    \end{macrocode}
%
%    The \cs{specialsection} command is a variation of the
%    \texttt{section} layout so has its own heading instance.
%    \begin{macrocode}
\DeclareDocumentCommand \specialsection {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {specialsection} {#1} {#2} {#3} }
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareDocumentCommand \subsection {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {subsection} {#1} {#2} {#3} }
%    \end{macrocode}
%
%
%    \begin{macrocode}
\DeclareDocumentCommand \subsubsection {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {subsubsection} {#1} {#2} {#3} }
%    \end{macrocode}
%
%
%    \begin{macrocode}
\DeclareDocumentCommand \paragraph {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {paragraph} {#1} {#2} {#3} }
%    \end{macrocode}
%
%
%    \begin{macrocode}
\DeclareDocumentCommand \subparagraph {s ={shorttitle}o m}
  { \ParseLaTeXeHeading {subparagraph} {#1} {#2} {#3} }
%    \end{macrocode}
