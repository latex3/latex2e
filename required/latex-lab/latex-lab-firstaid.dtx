%
%
%    The heading template instances have some subtle differences in the
%    different AMS classes. We therefore set all of them up by
%    document class, even though some of the code is the same.
%    
%    \begin{macrocode}
%<*amsbook>
%    \end{macrocode}
%    
%    
%    \begin{macrocode}
\DeclareInstance{heading}{part}{display}
  {
    , name                = part
    , level               = -1
    , placement           = page
    , start-code          =  \cleardoublepage \thispagestyle{empty}
                              \null \vfil \markboth{}{}
    , final-code          = \vfil \vfil \newpage\newpage \thispagestyle{empty}
    , mark-cmd            = \partmark {#1}
    , heading-decls       = \centering\huge\bfseries
    , headformat-instance = part
    , prefix              = \partname
    , number-format       = \theheading .
    , title-decls         = \Huge
  }
\DeclareInstance{headformat}{part}{display}
  {
    prefix-number-sep = \WordSpaceAmount{1},
  }
%    \end{macrocode}
%
%    Current heading templates aren't flexible enough and do not
%    properly support altering the layout for unnumbered headings
%    compared to their numbered counterparts. For this reason we have
%    two heading instances, one for \cs{chapter} and one for \cs{chapter*}.
%
%    \begin{macrocode}
\DeclareInstance{heading}{chapter}{display}
  {
    , name                 = chapter
    , level                = 0
    , mark-cmd             = \chaptermark {#1}
    , para-indent          = true
    , placement            = top
    , after-penalty-vspace = 32pt
    , after-vspace         = 22pt
    , heading-decls        = \normalsize\mdseries\centering
    , headformat-instance  = chapter
    , prefix               = \MakeUppercase{\chaptername}
    , number-format        = \thechapter
    , title-decls          = \fontsize{\@xivpt}{18} \bfseries
    , contents-extra       = \addtocontents{lof}{\protect\addvspace{10\p@}}
                             \addtocontents{lot}{\protect\addvspace{10\p@}}
  }
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareInstanceCopy{heading}{chapter*}{chapter}
\EditInstance{heading}{chapter*}{ after-penalty-vspace = 62pt }
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareInstance{headformat}{chapter}{display}
  {
    , heading-indent   = 0pt        %% <-- needed?
    , number-title-sep = 18pt
  }
%    \end{macrocode}
%    
%    
%    \begin{macrocode}
\DeclareInstance{heading}{section}{display}
  {
    , name                = section
    , level               = 1
    , mark-cmd            = \sectionmark{#1}
    , para-indent         = true
    , before-vspace       = 0.7\linespacing plus \linespacing
    , after-vspace        = 0.5\linespacing
    , heading-decls       = \normalfont \bfseries \centering
    , headformat-instance = section
    , number-format       = \theheading .
    , number-decls        = \upshape
  }
\DeclareInstance{headformat}{section}{hang}
  {
    number-title-sep = 0.5em,
  }
%    \end{macrocode}
%
%    A \cs{specialsection} is like a \cs{section} with two changes in
%    the parameter settings.  
%    \begin{macrocode}
\DeclareInstanceCopy{heading}{specialsection}{section}
\EditInstance{heading}{specialsection}
   {
     , before-vspace = 2\linespacing plus \linespacing
     , heading-decls = \large \scshape \centering
   }
%    \end{macrocode}
%    
%    \begin{macrocode}
\DeclareInstance{heading}{subsection}{runin}
  {
    , name                = subsection
    , level               = 2
    , mark-cmd            = \subsectionmark{#1}
    , before-vspace       = 0.5\linespacing plus 0.7\linespacing
