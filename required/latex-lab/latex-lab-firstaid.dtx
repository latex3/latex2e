% \changes{v0.85w}{2026/05/21}{Use new \cs{newtheoremstyle} with AMS classes}
%
%    In the ams classes's \cs{newtheoremstyle} has different defaults
%    compared to the standalone \pkg{amsthm} package. Therefore the
%    classes have their own implementation of the command that we need
%    to overwrite as well.
%
%    Provide a saved version of the \cs{newtheoremstyle} code in the
%    format to be able to reinstall it after the class got loaded.
%    \begin{macrocode}
%</amscls>
%<+package> \cs_set_eq:NN \newtheoremstyle@saved \newtheoremstyle
%<*amscls>
%    \end{macrocode}
%
%    Then reinstall it and also change the default for the vertical space.
%    \begin{macrocode}
\cs_set_eq:NN \newtheoremstyle \newtheoremstyle@saved 
\tl_set:Nn \newtheoremstyle@vspace@default {
  .5\baselineskip \@plus  .2\baselineskip \@minus .2\baselineskip
}
%    \end{macrocode}
