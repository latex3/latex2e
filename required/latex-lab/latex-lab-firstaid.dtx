    , heading-decls       = \normalfont \bfseries
    , headformat-instance = subsection
    , number-format       = \theheading .
    , number-decls        = \upshape
  }
\DeclareInstance{headformat}{subsection}{runin}
  {
    , number-title-sep = 0.5em
    , title-format     = #1 \AddPunctuation{.}
    , heading-indent   = \normalparindent
  }
%    \end{macrocode}
%    
%    \begin{macrocode}
