\DocumentMetadata
 {
  tagging = on,           % Enable tagged PDF
 }
\input{regression-test}
\documentclass{article} 
\title{some test}
\begin{document}
\tagpdfsetup
 {
  role/user-NS=user,
  role/new-NS={htmlA}{htmlA}{},
  role/new-NS={htmlB}{htmlB}{},
  role/new-tag={tag=span, role=Span, tag-namespace=htmlA},
  role/new-tag={tag=span, role=Lbl, tag-namespace=htmlB}
 }
% default names space of span: htmlB

\NewStructureName{test1}
\AssignStructureRole{test1}{unknown1-NonStruct} %NonStruct

\NewStructureName{test2}
\AssignStructureRole{test2}{P} 
\AssignStructureRole{test2}{unknown2-user-P-pdf2} % in user, rolemap to P/pdf

\NewStructureName{test3}
\AssignStructureRole{test3}{span/htmlA} 
\AssignStructureRole{test3}{unknown3-user-span-htmlA} % in user, rolemap to span/htmlA

\NewStructureName{test4}
\AssignStructureRole{test4}{span/htmlA} 
\AssignStructureRole{test4}{unknown4-htmlB-span-htmlA/htmlB} % in htmlB, rolemap to span/htmlA

\NewStructureName{test5}
\AssignStructureRole{test5}{span} 
\AssignStructureRole{test5}{unknown5-htmlA-span-htmlB/htmlA} % in htmlA, rolemap to span/htmlB

\NewStructureName{test6}
\AssignStructureRole{test6}{span} 
\AssignStructureRole{test6}{unknown6-user-span-htmlB/unknownNS} % in user, rolemap to span/htmlB
x
\end{document} 