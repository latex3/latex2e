% tmp test file to check redefinition of order key in "thmstyle" should vanish when
% code there is updated



\DocumentMetadata{tagging=on, lang=en}

\tagpdfsetup {math/mathml/luamml/load=false}

\input{regression-test}

\RequirePackage{latex-lab-testphase-template}




\documentclass{article}



\START

\DebugTemplatesOn

\errorcontextlines=1000


%\ShowTemplateInterface{float-setup}{std}
%\ShowTemplateDefaults{float-setup}{std}
%\ShowTemplateVariables{float-setup}{std}


\newtheorem{algo}{Algorithm}

\ShowInstanceValues{thmstyle}{plain}

\ExplSyntaxOn \makeatletter
\DeclareTemplateCode{thmstyle}{std}{4}
{
  ,numbered        = \l__block_numbered_bool
  ,separator       = \l__block_separator_tl
  ,punct           = \l__block_punct_tl
  ,caption-placement = {
     chained    = \bool_gset_false:N \g__block_label_standalone_bool
                  \bool_gset_false:N \g__block_label_unchained_bool
    ,unchained  = \bool_gset_false:N \g__block_label_standalone_bool
                  \bool_gset_true:N  \g__block_label_unchained_bool
    ,standalone = \bool_gset_true:N  \g__block_label_standalone_bool
                  \bool_gset_false:N \g__block_label_unchained_bool
   }
  ,caption-unbreakable = \l__block_caption_unbreakable_bool
  ,before-hspace   = \l__block_caption_before_skip
  ,after-hspace    = \l__block_caption_after_skip
  ,order           = \l__block_order_clist
  ,caption-decls   = \l__block_caption_decls_tl
  ,title-decls     = \l__block_title_decls_tl
  ,number-decls    = \l__block_number_decls_tl
  ,punct-decls     = \l__block_punct_decls_tl
  ,note-decls      = \l__block_note_decls_tl
  ,title-format    = \__block_title_format:n
  ,number-format   = \__block_number_format:n
  ,punct-format    = \__block_punct_format:n
  ,note-format     = \__block_note_format:n
  ,body-decls      = \l__block_body_decls_tl
}
{
  \template_debug_typeout:n{~\space template:~ 'std';~
                            arguments:~ \exp_not:o{\exp_after:wN |#1|#2|#3|#4|}}
  \SetKnownTemplateKeys{thmstyle}{std}{#1}
  \tl_if_empty:NF \UnusedTemplateKeys
     {
       \msg_error:nneo { block } { unknown-keys }
           { \l__block_env_name_tl \space environment}
           \UnusedTemplateKeys
     }
    \bool_lazy_or:nnT
      { \tl_if_empty_p:N \l__block_counter_tl }
      { #2 }
      { \bool_set_false:N \l__block_numbered_bool }
    \tl_set:Nn \l__block_note_tl {#3}
    \bool_if:NTF \l__block_numbered_bool
       {
         \@kernel@refstepcounter{ \l__block_counter_tl }
         \MakeLinkTarget{ \l__block_counter_tl }
       }
       {
         \MakeLinkTarget[theorem-like]{}
       }
    \hbox_gset:Nn \g__block_labels_box
      {
        \box_use_drop:N \g__block_labels_box % <- does nothing if
                                             % there is no dangling label
        \l__block_caption_decls_tl
        \tag_socket_use:nnn {captionedtext/caption} {}
            {
              \checkstatus{CAPTION}
              \skip_horizontal:n { \l__block_caption_before_skip }
%
              \tl_set_eq:NN \l__block_number_tl \l__block_counter_tl
%	      \tl_set:Nn \l__block_number_tag_tl {Lbl}
%	      
	      \template_process_order_clist:nnn  { block } { order }
   	                   { title, separator, number, punct, note, <label, label> }
%	      
              \skip_horizontal:n { \l__block_caption_after_skip }
            }
      }
   \bool_if:NTF \g__block_label_standalone_bool
      {
        \bool_gset_true:N \g__block_label_standalone_bool
        \para_omit_indent:
        \box_use_drop:N \g__block_labels_box
        \par
      }
      {
        \legacy_if_gset_true:n { @newlist }
        \legacy_if_gset_true:n { @inlabel }
      }
    \legacy_if_gset_true:n { @nobreak }
    \__block_debug_typeout:n{Set~ captioned~ block~ everypar \on@line }
    \cs_set_eq:NN \__block_everypar: \__block_captioned_everypar_std:
    \l__block_body_decls_tl
  \__block_debug_typeout:n{template:thmstyle:std~end}
}

\DebugSocketsOn

\template_new_order_group:nnnnnn {block} {label}
  { }
  {
%FMi fix tag name    
    \tag_struct_begin:n{tag=Lbl}
    \tag_mc_begin:n{}
  }
  { }
  {
    \tag_mc_end: \tag_struct_end:
  }

\DebugSocketsOff

\ExplSyntaxOff
\makeatother


\DeclareInstance{thmstyle}{plain}{std}
  {
    ,caption-placement = unchained
    ,numbered          = true
    ,separator         = \ 
    ,punct             = . 
    ,before-hspace     = 0pt
    ,after-hspace      = 5pt plus 1pt minus 1pt
    ,order             = { <label, title, separator, number, label>, separator, note, punct }
    ,caption-decls     = \bfseries
    ,title-decls       = 
    ,number-decls      = \upshape
    ,punct-decls       = 
    ,note-decls        = \upshape\mdseries
    ,title-format      = #1
    ,number-format     = \arabic{#1}
    ,punct-format      = #1
    ,note-format       = (#1)
    ,body-decls        = \itshape
  }


\OMIT
\begin{document}
\TIMO

\DebugSocketsOn

\begin{algo}
Test
\end{algo}

\DebugSocketsOff

\begin{algo}[note]
Test2
\end{algo}


\end{document}


