% \subsection{Package options}
% 
%    
%    
%    \begin{macrocode}
%<@@=ttl>
%    \end{macrocode}
%    
%    \begin{macrocode}
\tl_new:N \l_@@_fonts_tl
%    \end{macrocode}
%    
%    \begin{macrocode}
\DeclareOption{rm}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\rmfamily} }
\DeclareOption{sf}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\sffamily} }
\DeclareOption{tt}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\ttfamily} }
\DeclareOption{md}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\mdseries} }
\DeclareOption{bf}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\bfseries} }
\DeclareOption{up}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\upshape} }
\DeclareOption{it}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\itshape} }
\DeclareOption{sl}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\slshape} }
\DeclareOption{sc}{%
  \tl_put_right:Nn \l_@@_fonts_tl {\scshape} }
%    \end{macrocode}
%    
%    \begin{macrocode}
\DeclareOption{big}{%
  \gdef\ttl@sizes#1{\ifcase#1\relax\Huge\or\Large\or\large
       \or\normalsize\or\or\or\huge\fi}}
\DeclareOption{medium}{%
  \gdef\ttl@sizes#1{\ifcase#1\relax\huge\or\Large\or\large
       \or\normalsize\or\or\or\LARGE\fi}}
\DeclareOption{small}{%
  \gdef\ttl@sizes#1{\ifcase#1\relax\LARGE\or\large
       \or\normalsize\or\normalsize\or\or\or\Large\fi}}
\DeclareOption{tiny}{%
  \gdef\ttl@sizes#1{\ifcase#1\relax\large\or\normalsize\or
    \normalsize\or\normalsize\or\or\or\normalsize\fi}}
%    \end{macrocode}
%    
%    \begin{macrocode}
\def\ttl@sizes#1{\ifcase#1\relax\Huge\or\Large\or\large
       \or\normalsize\or\or\or\huge\fi}
%    \end{macrocode}
%    
%    \begin{macrocode}
\DeclareOption{compact}{%
  \gdef\ttl@space{1}%
  \gdef\ttl@chapafter{30\p@}}

%    \end{macrocode}
%    
%    \begin{macrocode}
\ExecuteOptions{
%  rubberchapters,
%  bottomtitles,
%  aftersep,
%  oldparttoc,
%  innermarks
}
%    \end{macrocode}
%    
%    \begin{macrocode}
\ProcessOptions
%    \end{macrocode}
%
%    \begin{macrocode}
\tl_if_empty:NT \l_@@_fonts_tl {
  \tl_set:Nn \l_@@_fonts_tl {\bfseries}
}


%    \end{macrocode}
%    
%    \begin{macrocode}
\cs_new:Npn \skip_mult:nn #1#2{
  \tex_glueexpr:D
    #2 \tex_glueexpr:D #1 \scan_stop:
  plus
    \dim_to_decimal:n
      { #2 \tex_gluestretch:D \tex_glueexpr:D #1 \scan_stop: }
    \if_case:w
      \tex_gluestretchorder:D \tex_glueexpr:D #1 \scan_stop:
      pt  \or:  fil  \or:  fill  \or: filll
    \fi:
  minus
    \dim_to_decimal:n
      { #2 \tex_glueshrink:D \tex_glueexpr:D #1 \scan_stop: }
    \if_case:w
       \tex_glueshrinkorder:D \tex_glueexpr:D #1 \scan_stop:
      pt  \or:  fil  \or:  fill  \or: filll
    \fi:
  \scan_stop:
}
%    \end{macrocode}
%    
%    \begin{macrocode}
\cs_new_protected:Npn \skip_mult:Nn #1#2 {
  #1 = \skip_mult:nn #1 {#2}
}
%    \end{macrocode}
%    
%    \begin{macrocode}
\cs_new_protected:Npn \skip_gmult:Nn #1#2 {
  \tex_global:D #1 = \skip_mult:nn #1 {#2}
}
%    \end{macrocode}
