%
% The \cs{titlespacing} declaration has the following syntax:
% \begin{verbatim}
%  \titlespacing*{cmd}{left-sep}{before-vspace}{after-vspace}[right-sep]
% \end{verbatim}
%
%
%    All commands that do not have an emulation yet simply raise an
%    error (we try to pick up the arguments that follow but that may
%    not always work).
%    \begin{macrocode}
\newcommand\csnotyetprovided[1]{
  \PackageWarning{titlesec~ emulation}{Command~ \noexpand#1 not~ yet~ emulated.
    \MessageBreak
    The~ titlesec~ emulation~ is~ not~ yet~ complete
    \MessageBreak
    and~ this~ command~ is~ ignored~ in~ documents
    \MessageBreak
    using~ \string\DocumentMetadata.
    \MessageBreak
    Found 
  }
}
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareDocumentCommand\titleformat {smommmmo}{ \csnotyetprovided \titleformat }
\DeclareDocumentCommand\titlespacing{smmmmo}  { \csnotyetprovided \titlespacing }
\DeclareDocumentCommand\titlelabel  {som}     { \csnotyetprovided \titlelabel }
\DeclareDocumentCommand\nostruts    {}        { \csnotyetprovided \nostruts }
\DeclareDocumentCommand\titleline   {som}     { \csnotyetprovided \titleline }
%    \end{macrocode}
%
%    \begin{macrocode}
\DeclareDocumentCommand\titlerule{so}
                       { \IfBooleanTF #1 \titleruleleaders \titlerulenormal }
\DeclareDocumentCommand\titleruleleaders{m} { \csnotyetprovided \titlerule }
\DeclareDocumentCommand\titlerulenormal {}  { \csnotyetprovided \titlerule }
%    \end{macrocode}
%
%    \begin{macrocode}
\newcommand \iftitlemeasuring { \csnotyetprovided \iftitlemeasuring \@secondoftwo}
%    \end{macrocode}
