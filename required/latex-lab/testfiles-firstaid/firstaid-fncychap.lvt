
\DocumentMetadata{tagging=on,pdfstandard=ua-2,lang=en,uncompress}

\documentclass{book}

% For testing we alter LaTeX's option handling so that the macros containing the
% option code are not emptied at the end of the package. This enables us to use
% \ds@Lenny, \ds@Sonny, etc. in the test code showing the results of the different
% package option in one document.

\makeatletter
% save original and restore it after fncychap got loaded.
\let\@process@pti@ns@saved\@process@pti@ns
% then change:
\def\@process@pti@ns{%
  \@for\CurrentOption:=\@curroptions\do{%
    \@ifundefined{ds@\detokenize\expandafter{\CurrentOption}}%
      {\@use@ption
       \default@ds}%
      \@use@ption}%
% don't do the next two lines so that the \ds@... commands aren't removed:
%  
%  \@for\CurrentOption:=\@declaredoptions\do{%
%    \expandafter\let\csname ds@\CurrentOption\endcsname\relax}%
%
  \let\CurrentOption\@empty
  \let\@fileswith@pti@ns\@@fileswith@pti@ns
  \AtEndOfPackage{\expandafter\let
                     \csname unprocessedoptions-\@currname.\@currext\endcsname
                     \relax}}
\makeatother

% Now load the package without option so that we get LaTeX headings by
% default.

\usepackage{fncychap}

\usepackage{color}     % necessary for one of the chapter styles



\makeatletter

% Restore the option handler to its standard definition

\let\@process@pti@ns\@process@pti@ns@saved


% Define a command to test chapters in front, main, backmatter and for the appendix.
% The argument contains a chapter style name, i.e., one that would normally be used
% as an option to the package.

\newcommand\testdata[1]{
\typeout{================== #1 =============}
% 
% Load the code of one option:
% 
  \csname ds@#1\endcsname
% 
% Generate a chapter heading in front/main/appendix/backmatter each:
% 
  \frontmatter  \chapter{Frontmatter -- #1}  Some text.   \section*{A section} More text.
  \mainmatter   \chapter{Main -- #1}         Some text.   \section{A section} More text.
  \mainmatter   \chapter{More Main -- #1}    Some text.   \section{A section} More text.
  \appendix     \chapter{Appendix -- #1}     Some text. %  \section{A section} More text.
  \backmatter   \chapter{Backmatter -- #1}   Some text. %  \section{A section} More text.
%
% Undo the \appendix settings for next trial  
%
  \def\@chapapp{\chaptername}%
  \protected\def\thechapter{\thespecialchapter\arabic}%
  \setcounter{chapter}{0}%
}
\makeatother

\input{regression-test}

\DebugHeadingsOn
\DebugTemplatesOn

\begin{document}

\START

\title{Testing fncychap headings}
\author{Frank Mittelbach, \LaTeX{} Project}
\date{2026-09-09}
\maketitle

% Test each chapter style in turn, starting with LaTeX's default layout

\testdata{LaTeX default layout}
\testdata{Lenny}
\testdata{Sonny}
\testdata{PetersLenny}
\testdata{Glenn}
\testdata{Conny}
\testdata{Rejne}
\testdata{Bjarne}
\testdata{Bjornstrup}

\SHOWPDFTAGS

\end{document}

