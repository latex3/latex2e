\DocumentMetadata{tagging=off}

\documentclass{article}

\flushbottom  % to show the difference!

\input{regression-test}

\EditInstance{heading}{section}{placement=ragged}
\ShowInstanceValues{heading}{section}


\setlength\textheight{6\baselineskip}

\showoutput

\begin{document}

 
A\par B\par C\par 

\DebugHeadingsOn

\section[placement=normal]{X}

Two \\ lines

\newpage

A\par B\par C\par 

\section{X}

Two \\ lines

\end{document}


\makeatletter
\newif\ifraggedbottomsection
\raggedbottomsectionfalse
\raggedbottomsectiontrue
\newcommand*{\bottomsectionpenalty}{\z@}
\newlength{\bottomsectionskip}
\setlength{\bottomsectionskip}{10mm}

\NewCommandCopy\@normal@startsection\@startsection
\def\@startsection{%
  \ifraggedbottomsection\if@nobreak\else%
      \vskip\z@\@plus\bottomsectionskip%
      \penalty\bottomsectionpenalty%
      \vskip\z@\@plus -\bottomsectionskip%
    \fi\fi%
\@normal@startsection}

\makeatother
