\DocumentMetadata{uncompress,tagging=on}
\input{regression-test}
\documentclass{article}

\author{Author A \and Author B}
\makeatletter 


\ExplSyntaxOn
% for tags in html space:
\tagpdfsetup
 {
  role/new-NS={html}{http://www.w3.org/1999/xhtml}{},
  role/new-tag={tag=h1,tag-namespace=html,role=Title},
  role/new-tag={tag=h2,tag-namespace=html,role=H1},
  role/new-tag={tag=h3,tag-namespace=html,role=H2},
  role/new-tag={tag=h4,tag-namespace=html,role=H3},
  role/new-tag={tag=h5,tag-namespace=html,role=H4},
  role/new-tag={tag=h6,tag-namespace=html,role=H5}
 }
% for aria-attribute on title-text:
\tagpdfsetup{
  role/new-attribute=
    {aria-heading-1}{/O/ARIA-1.1/role (heading)/aria-level~1}}
\NewTaggingSocketPlug{title}{aria}
 {
   \par
   \group_begin:
     \tagpdfparaOff
     \tag_struct_begin:n{tag=\UseStructureName{title/text},attribute=aria-heading-1}\tagmcbegin{}#2\tagmcend\tag_struct_end:%
     \par
   \group_end:
 }

% for title role mapped to H1 in html-style, allows to move down the Hn-number of the other headings:  
\tagpdfsetup
  {
    role/new-NS={latex-html}{https://www.latex-project.org/ns/html}{},
    role/new-tag={tag=title-text,tag-namespace=latex-html,role=H1},
    role/new-tag={tag=section-heading,tag-namespace=latex-html,role=H2},
    role/new-tag={tag=subsection-heading,tag-namespace=latex-html,role=H3},
    role/new-tag={tag=subsubsection-heading,tag-namespace=latex-html,role=H4},
    role/new-tag={tag=paragraph-heading,tag-namespace=latex-html,role=H5},
    role/new-tag={tag=subparagraph-heading,tag-namespace=latex-html,role=H6},
% for book classes       
    role/new-NS={latex-html-book}{https://www.latex-project.org/ns/html-book}{},
    role/new-tag={tag=chapter-heading,tag-namespace=latex-html-book,role=H2},
    role/new-tag={tag=section-heading,tag-namespace=latex-html-book,role=H3},
    role/new-tag={tag=subsection-heading,tag-namespace=latex-html-book,role=H4},
    role/new-tag={tag=subsubsection-heading,tag-namespace=latex-html-book,role=H5},
    role/new-tag={tag=paragraph-heading,tag-namespace=latex-html-book,role=H6},
    role/new-tag={tag=subparagraph-heading,tag-namespace=latex-html-book,role=H7},    
  }
% for the test, to be able to use maketitle more than once:    
\ExplSyntaxOff \makeatletter
\newcommand\savemaketitle{%
  \global\let\orithanks\thanks
  \global\let\orimaketitle\maketitle
  \global\let\ori@maketitle\@maketitle
  \global\let\ori@thanks\@thanks
  \global\let\ori@author\@author
  \global\let\ori@date\@date
  \global\let\ori@title\@title
  \NewCommandCopy\orititle\title
  \NewCommandCopy\oriauthor\author
  \global\let\oridate\date
  \global\let\oriand\and}
\newcommand\restoremaketitle{% 
  \global\let\thanks\orithanks
  \global\let\maketitle\orimaketitle
  \global\let\@maketitle\ori@maketitle
  \global\let\@thanks\ori@thanks
  \global\let\@author\ori@author
  \global\let\@date\ori@date
  \global\let\@title\ori@title
  \NewCommandCopy\title\orititle
  \NewCommandCopy\author\oriauthor
  \global\let\date\oridate
  \global\let\and\oriand}
\savemaketitle
%\makeatother
\begin{document}
\START
\SHOWPDFTAGS
%ensure the default mapping in the test:
\AssignStructureRole{sec/1/title}{section-heading/latex}  
\AssignStructureRole{sec/2/title}{subsection-heading/latex}  
\AssignStructureRole{sec/3/title}{subsubsection-heading/latex}  
\AssignStructureRole{sec/4/title}{paragraph-heading/latex}  
\AssignStructureRole{sec/5/title}{subparagraph-heading/latex}  

%%%%%%%% Example 1 %%%%%%%%
\title{title=default}
Title text role mapped to \texttt{Title}.
Sections role mapped to H1, subsections to H2 etc

\maketitle
\restoremaketitle

\section{a section}
\subsection{a subsection}

\newpage 
\tagpdfsetup{sec/end=1}
%%%%%%%% Example 2 %%%%%%%%
\title{title=H1}

Title role mapped to H1, headings moved down one level, so sections role mapped to H2, subsections to H3.

\AssignStructureRole{title/text}{title-text/latex-html}
\AssignStructureRole{sec/1/title}{section-heading/latex-html}  
\AssignStructureRole{sec/2/title}{subsection-heading/latex-html}  
\AssignStructureRole{sec/3/title}{subsubsection-heading/latex-html}  
\AssignStructureRole{sec/4/title}{paragraph-heading/latex-html}  
\AssignStructureRole{sec/5/title}{subparagraph-heading/latex-html}  

% book classes
%\AssignStructureRole{sec/0/title}{chapter-heading/latex-html-book}
%\AssignStructureRole{sec/1/title}{section-heading/latex-html-book}  
%\AssignStructureRole{sec/2/title}{subsection-heading/latex-html-book}  
%\AssignStructureRole{sec/3/title}{subsubsection-heading/latex-html-book}  
%\AssignStructureRole{sec/4/title}{paragraph-heading/latex-html-book}  
%\AssignStructureRole{sec/5/title}{subparagraph-heading/latex-html-book}  


\maketitle
\restoremaketitle

\section{a section}
\subsection{a subsection}

\newpage 
\tagpdfsetup{sec/end=1}

%%%% Example 3 %%%%%
\title{title=html}
Titles and headings using html name space (with the exception of subparagraph in book as there is no h7 in html), title role mapped to Title, first heading level role mapped to H1.

\AssignStructureRole{title/text}{h1} 
\AssignStructureRole{sec/1/title}{h2} %section role mapped to H1  
\AssignStructureRole{sec/2/title}{h3} %subsection 
\AssignStructureRole{sec/3/title}{h4} %subsubsection 
\AssignStructureRole{sec/4/title}{h5} %paragraph 
\AssignStructureRole{sec/5/title}{h6} %subparagraph 

% for book classes, what to do with subparagraph? 
%\AssignStructureRole{sec/0/title}{h2} %role mapped to H1  
%\AssignStructureRole{sec/1/title}{h3} %role mapped to H1  
%\AssignStructureRole{sec/2/title}{h4}  
%\AssignStructureRole{sec/3/title}{h5}  
%\AssignStructureRole{sec/4/title}{h6}  
%\AssignStructureRole{sec/5/title}{??}  

\maketitle
\restoremaketitle
\section{a section}
\subsection{a subsection}


\newpage 
\tagpdfsetup{sec/end=1}
\title{title=aria}

Title with an aria role ``heading'' with level 1. 
sections are role mapped to H1. 
Do they need aria roles too? Or should one move them down?
  
\AssignStructureRole{title/text}{title-text/latex}
\AssignTaggingSocketPlug{title}{aria}
\AssignStructureRole{sec/1/title}{section-heading/latex}       %mapped to H1  
\AssignStructureRole{sec/2/title}{subsection-heading/latex}    %subsection 
\AssignStructureRole{sec/3/title}{subsubsection-heading/latex} %subsubsection 
\AssignStructureRole{sec/4/title}{paragraph-heading/latex}     %paragraph 
\AssignStructureRole{sec/5/title}{subparagraph-heading/latex}  %subparagraph 
\maketitle
\restoremaketitle
\section{a section}
\subsection{a subsection}

\end{document}
