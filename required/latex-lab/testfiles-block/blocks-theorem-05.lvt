\section{Testing opt arg variants}

\begin{thm}[It has a name] \label{eq}
  X
\end{thm}

\begin{thm}[number=\ref{eq}\textsuperscript{*}]
  Special number referencing previous thm.
\end{thm}

\begin{thm}[correct number?]
  Should be 2.
\end{thm}

\begin{thm}[numbered=false]
  Don't want a number.
\end{thm}


\begin{lem*}
  An unnumbered lemma.
\end{lem*}

\begin{lem*}[numbered=true]
  Forcing numbering this way is not supported.
\end{lem*}

\begin{thm}
  Which number now? Should be 3.
\end{thm}


\begin{proof}
  Default.
\end{proof}

\begin{proof}[Foo]
  Title change via optional arg.
\end{proof}

\begin{proof}[title=Foo,caption-decls=\sffamily]
  Title change via title key and extra decls.
\end{proof}

\begin{proof}[optarg=Bar,title=Foo,title-decls=\bfseries]
  With optarg and title optarg wins
\end{proof}

\begin{proof}[note=Foo]
  Adding a note
\end{proof}

\begin{proof}[title=Foo,note=Bar,note-decls=\sffamily]
  Adding a title and note and some decls
\end{proof}


\begin{thm}[Foo]
  With note.
\end{thm}

\begin{thm}[optarg=Foo]
  With note in optarg
\end{thm}

\begin{thm}[note=Foo,caption-decls=\sffamily]
  Note plus decls for the whole caption.
\end{thm}

\begin{thm}[note=Foo,optarg=Bar]
  With note and optarg the latter wins.
\end{thm}


\typeout{Test for color leakage into caption}

\begin{thm}[body-decls=\color{blue}]
\begin{itemize}
  \item test
\end{itemize}
\end{thm}

\begin{thm}[body-decls=\color{blue}\sffamily]
Text first in blue.

\color{black} % sffamily should survive

\begin{itemize}
  \item test
\end{itemize}
\end{thm}


