\section{Horizontal spacing keys}

\subsection{leftmargin}

some text
\begin{enumerate}[leftmargin=5cm]
\item abc
\item abc
\end{enumerate}

\begin{enumerate}[labelwidth=4cm,leftmargin=!]
\item abc
\item abc
\end{enumerate}

FAIL: * does not work, labelwidth should be resetted. 
\begin{enumerate}[labelwidth=4cm,leftmargin=*]
\item abc
\item abc
\end{enumerate}

\subsection{rightmargin}

some text
\begin{enumerate}[rightmargin=5cm]
\item \lipsum[1][1-3]
\item abc
\end{enumerate}


\subsection{listparindent}
some text


\begin{enumerate}[listparindent=5cm]
\item \lipsum[1][1] \par \lipsum[1][1]
\item abc
\end{enumerate}

\subsection{labelwidth}

DIFF: enumitem resets labelwidth in description

\begin{description}[labelwidth=5cm]
\item[pears] a sentence \par a sentence
\item[apples] abc
\end{description}


\subsection{labelsep}

DIFF some text 
\begin{description}[labelsep=4cm]
\item[pears] a sentence \par a sentence
\item[apples] abc
\end{description}


\subsection{labelindent}

DIFF
\begin{description}[labelindent=4cm,leftmargin=!]
\item[pears] a sentence \par a sentence
\item[apples] abc
\end{description}

\begin{itemize}[labelindent=4cm,leftmargin=!]
\item a sentence \par a sentence
\item abc
\end{itemize}

\begin{enumerate}[labelindent=4cm,leftmargin=!]
\item a sentence \par a sentence
\item abc
\end{enumerate}


\subsection{itemindent}
FAIL 
\begin{description}[itemindent=4cm]
\item[pears] a sentence \par a sentence
\item[apples] abc
\end{description}

\subsection{meta key wide}
\begin{description}[wide]
\item[pears] \lipsum[1][1-3]
\end{description}

