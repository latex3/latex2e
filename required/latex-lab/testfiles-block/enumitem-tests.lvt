\documentclass[10pt]{article}
\usepackage{enumitem}
\usepackage{lipsum}
\usepackage[english]{babel}
\usepackage[autostyle]{csquotes}
\title{Replacing enumitem with new block code}
\begin{document}
\START\showoutput
\section{Horizontal spacing keys}

\subsection{leftmargin}

some text
\begin{enumerate}[leftmargin=5cm]
\item abc
\item abc
\end{enumerate}

\begin{enumerate}[labelwidth=4cm,leftmargin=!]
\item abc
\item abc
\end{enumerate}

\begin{enumerate}[labelwidth=4cm,leftmargin=*]
\item abc
\item abc
\end{enumerate}

\subsection{rightmargin}

some text
\begin{enumerate}[rightmargin=5cm]
\item \lipsum[1][1-3]
\item abc
\end{enumerate}


\subsection{listparindent}
some text


\begin{enumerate}[listparindent=5cm]
\item \lipsum[1][1] \par \lipsum[1][1]
\item abc
\end{enumerate}

\subsection{labelwidth}

\begin{description}[labelwidth=5cm]
\item[pears] \lipsum[1][1] \par \lipsum[1][1]
\item[apples] abc
\end{description}

\subsection{labelsep}

\begin{description}[labelsep=4cm]
\item[pears] \lipsum[1][1] \par \lipsum[1][1]
\item[apples] abc
\end{description}


\subsection{itemindent: needs extra key definition}

\begin{description}[itemindent=4cm]
\item[pears] \lipsum[1][1] \par \lipsum[1][1]
\item[apples] abc
\end{description}


\section{Vertical spacing keys} %complete
\subsection{topsep}
some text
\begin{enumerate}[topsep=1cm]
\item abc
\item abc
\end{enumerate}
some text
\end{document}




\subsection{partopsep: works}
some text

\begin{enumerate}[partopsep=1cm]
\item abc
\item abc
\end{enumerate}

\subsection{partopsep: works}
some text

\begin{enumerate}[begin-extra-vspace=1cm]
\item abc
\item abc
\end{enumerate}


\subsection{parsep: needs extra key definition} % Do you mean par-skip?
% Frank has one line commented setting \parsep
name is para-vspace:
\ExplSyntaxOn
\keys_define:nn{template/block/display}
{ parsep .meta:n = {para-vspace=#1}}
\ExplSyntaxOff
\begin{enumerate}[para-vspace=1cm]
\item abc \par next par
\item abc
\end{enumerate}
\begin{enumerate}[parsep=1cm]
\item abc \par next par
\item abc
\end{enumerate}


\subsection{itemsep: needs extra key definition}
% Block issue again
name is item-vspace: 
\ExplSyntaxOn
\keys_define:nn{template/list/std}
{ itemsep .meta:n = {item-vspace=#1}}
\ExplSyntaxOff
\begin{enumerate}[item-vspace=1cm]
\item abc \par next par
\item abc
\end{enumerate}
\begin{enumerate}[itemsep=1cm]
\item abc \par next par
\item abc
\end{enumerate}


\section{Meta spacing keys and special options} 
General question: how to setup meta keys and alias keys?
% Would need an extension to lttemplates if we want them in the template declaration:
% if only for ad hoc changes, can use l3keys, just need to document how to do it
\begin{itemize}
\item \verb+\parindent+ as value returns outer \verb+\parindent+
\item spacing keys take special \enquote{values} like \verb+!+ and \verb+*+

\item \texttt{nosep} key, \texttt{noitemsep} key, 
\item \texttt{labelindent} key (space from margin to left edge of label)
\item \texttt{left}
\item \texttt{widest}
\item \verb+labelsep*+
\item \verb+labelindent*+
\item \verb+wide=+
\end{itemize}

\section{Label and reference format}
\subsection{label: needs extra key definition}
name is item-label. \verb+*+ syntax is not supported.
\ExplSyntaxOn
\keys_define:nn{template/list/std}
{ label .meta:n = {item-label={#1}}}
\ExplSyntaxOff
\begin{enumerate}[item-label=(\alph{enumi})]
\item abc 
\item abc
\end{enumerate}
\begin{enumerate}[label=(\alph{enumi})]
\item abc 
\item abc
\end{enumerate}
\subsection{label*: does not work}

\subsection{ref: does not work}

\subsection{align: work with different key name}
key name is label-align

\ExplSyntaxOn
\keys_define:nn{template/item/std}
{ align .meta:n = {label-align={#1}}}
\ExplSyntaxOff

\begin{description}[label-width=3cm,label-align=right]
\item[bear] abc 
\item[elefant] abc
\end{description}

\begin{description}[labelwidth=3cm,align=right]
\item[bear] abc 
\item[elefant] abc
\end{description}

\subsection{font, format: works with different syntax and key name}

\begin{description}[label-format = \fbox{\normalfont\itshape #1},label-align=right]
\item[hallo hallo hallo] First item.
\item[hallo] Second item.
\end{description}


\section{Numbering}
\subsection{start: works}

\begin{enumerate}[start=15]
\item abc 
\item abc
\end{enumerate}
%TODO

\subsection{resume: works (?)}
Behaviour is slightly different to enumitem, where grouping of the environments matters.

\begin{enumerate}
\item First item.
\item Second item.
\end{enumerate}
Text.
\begin{enumerate}[resume]
\item Third item
\end{enumerate}

\subsection{resume*: does not work}

Unclear if copying of options like that should really be supported. 

\subsection{series: does not work}

resume=series, resume*=series, series are not supported.




\section{Penalties}
\subsection{beginpenalty, endpenalty: needs extra key definition}

name is begin-penalty, end-penalty:
\ExplSyntaxOn
\keys_define:nn{template/block/display}
{ 
  beginpenalty .meta:n = {begin-penalty=#1},
  endpenalty .meta:n = {end-penalty=#1}
}
\ExplSyntaxOff
\begin{enumerate}[beginpenalty=10000,endpenalty=500]
\item Third item
\end{enumerate}

\subsection{midpenalty: needs extra key definition}
name is item-penalty.
\ExplSyntaxOn
\keys_define:nn{template/list/std}
{ midpenalty .meta:n = {item-penalty=#1}}
\ExplSyntaxOff




\section{Injecting Code}

Keys are \texttt{before}, \texttt{before*}, \texttt{after}, \texttt{after*}, \texttt{first},
\texttt{first*}. The star forms append code. None is supported, it must be checked where exactly they
are executed.

\section{Description styles}

The key is \texttt{style} with values \texttt{nextline}, \texttt{sameline}, \texttt{unboxed}, \texttt{standard},
\texttt{multiline}. The block code has keys like \texttt{next-line} but use and implementation status are unclear.

\end{document} 
